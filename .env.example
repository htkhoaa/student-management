# 1. Database Configuration
DB_HOST=db
DB_NAME=student_management
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_PORT_HOST=5432
DB_PORT_CONTAINER=5432

# 2. Web App Configuration
APP_PORT_HOST=8000
APP_PORT_CONTAINER=8000

# 3. Security
SECRET_KEY=YOUR_SECRET_KEY
ALGORITHM=HS256
JWT_TOKEN_EXPIRATION=3600

# 4. Environment settings
DEBUG=True

# 5. Database URL
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT_CONTAINER}/${DB_NAME}